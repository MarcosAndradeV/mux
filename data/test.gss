scenes = {
    hallway = {
        background = {
            path = "data/assets/hallway_bg.png",
            top = 10%,
            left = 10%,
            scale = 300%,
        }
        hotspots = {
            door_to_kitchen = {
                //frame = true,
                left = 21%,
                top = 25%,
                width = 120.0,
                height = 240.0,
                cursor = "exit_left",
                tooltip = "Go to Kitchen",
                on_click = "action:change_scene kitchen",
            },
            locked_drawer = {
                //frame = true,
                left = 55%,
                top = 48.5%,
                width = 145.0,
                height = 102.0,
                cursor = "grab",
                tooltip = "Locked Drawer",
                on_click = "script:interact_drawer",
            }
        }
    }

    kitchen = {
        background = "data/assets/kitchen_bg.png",
        hotspots = {
            door_to_hallway = {
                left = 75%,
                top = 20%,
                width = 120.0,
                height = 240.0,
                cursor = "exit_right",
                tooltip = "Go back to Hallway",
                on_click = "action:change_scene hallway",
            },
            brass_key = {
                left = 40%,
                top = 70%,
                width = 60.0,
                height = 40.0,
                cursor = "grab",
                tooltip = "Take key",
                visible_if = "!flags.has_brass_key",
                on_click = "action:pick_up_item brass_key",
            }
        }
    }
}
