message = {
    top = 50%,
    left = 50%,
    font_size = 40.0,
    spacing = 5.0,
    color = "yellow",
    align = "center",
    valign = "middle",
}

timer = {
    frame = true,
    top = 85%,
    left = 20%,
    font_size = message.font_size,
    spacing = message.spacing,
    color = "white",
    align = "center",
    valign = "middle",
}

clock = {
    top = 15%,
    left = timer.left,
    font_size = message.font_size,
    spacing = message.spacing,
    color = "yellow",
    align = "center",
    valign = "middle",
}

default_button = {
    color = "white",
}

penger = {
    top = 5%,
    left = 5%,
    scale = 200%,
    color = "white",
    align = "center",
    valign = "middle",
    button = default_button
}
