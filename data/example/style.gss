message = {
    top = 50%,
    left = 50%,
    font_size = 40.0,
    spacing = 5.0,
    color = "white",
    frame = true,
}

timer = {
    top = 85%,
    left = 20%,
    font_size = message.font_size,
    spacing = message.spacing,
    color = "white",
    frame = true,
}

clock = {
    top = 15%,
    left = timer.left,
    font_size = message.font_size,
    spacing = message.spacing,
    color = "yellow",
    frame = true,
}

penger = {
    frame = true,
    top = 5%,
    left = 5%,
    color = "white",
}
